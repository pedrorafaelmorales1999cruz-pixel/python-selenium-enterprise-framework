from selenium import webdriver
from selenium.webdriver.common.by import By
import time

driver = webdriver.Edge()

try:
    # 1. Ir a la página de Checkboxes
    driver.get("https://the-internet.herokuapp.com/checkboxes")
    print("Página de Checkboxes abierta.")

    # LOCALIZADOR POR XPATH (Buscamos el primer checkbox)
    # El XPath //form[@id='checkboxes']/input[1] dice: 
    # "Busca el formulario con id checkboxes y dame el primer input"
    check1 = driver.find_element(By.XPATH, "//form[@id='checkboxes']/input[1]")
    
    if not check1.is_selected():
        print("Marcando el primer checkbox...")
        check1.click()

    time.sleep(2)

    # 2. Ir a la página de Inputs
    driver.get("https://the-internet.herokuapp.com/inputs")
    
    # LOCALIZADOR POR TIPO DE ETIQUETA (Solo hay un input de número)
    campo_numero = driver.find_element(By.TAG_NAME, "input")
    campo_numero.send_keys("12345")
    print("Número ingresado correctamente.")

    time.sleep(2)

    # 3. Tomar evidencia del éxito
    driver.save_screenshot("practica_localizadores.png")
    print("✅ Prueba de localizadores terminada.")

finally:
    driver.quit()